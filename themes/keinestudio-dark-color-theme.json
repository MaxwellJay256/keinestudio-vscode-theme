    },
    {
      "name": "删除线",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#7F92A3", "fontStyle": "strikethrough" }
    },
    {
      "name": "差异新增",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#A5C491" }
    },
    {
      "name": "差异删除",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E19999" }
    },
    {
      "name": "差异修改与分隔线",
      "scope": ["markup.changed", "meta.separator"],
      "settings": { "foreground": "#E9DEB1" }
    },
    {
      "name": "差异文件头",
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": { "foreground": "#8FB5D9" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8FB5D9",
    "type": "#8FB5D9",
    "class": "#8FB5D9",
    "enum": "#8FB5D9",
    "interface": "#8FB5D9",
    "struct": "#8FB5D9",
    "typeParameter": "#8FB5D9",
    "parameter": "#CBCAD0",
    "variable": "#CBCAD0",
    "property": "#C4D7EA",
    "enumMember": "#E9DEB1",
    "function": "#E19999",
    "method": "#E19999",
    "macro": "#E9DEB1",
    "keyword": "#D46868",
    "modifier": "#D46868",
    "comment": { "foreground": "#7F92A3", "italic": true },
    "string": "#A5C491",
    "number": "#E9DEB1",
    "regexp": "#CBDBC0",
    "operator": "#C4D7EA",
    "decorator": "#E9DEB1",
    "variable.readonly": "#E9DEB1",
    "property.readonly": "#E9DEB1",
    "variable.defaultLibrary": "#C4D7EA",
