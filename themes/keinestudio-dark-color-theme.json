    },
    {
      "name": "已弃用代码",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#7F92A3", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown 正文",
      "scope": ["text.html.markdown"],
      "settings": { "foreground": "#CBCAD0" }
    },
    {
      "name": "Markdown 标题",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#C4D7EA", "fontStyle": "bold" }
    },
    {
      "name": "Markdown 标题与列表标记",
      "scope": ["punctuation.definition.heading.markdown", "punctuation.definition.list.begin.markdown", "punctuation.definition.list_item.markdown"],
      "settings": { "foreground": "#D46868" }
    },
    {
      "name": "Markdown 行内代码与原始文本",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": { "foreground": "#CBDBC0" }
    },
    {
      "name": "Markdown 代码围栏",
      "scope": ["punctuation.definition.fenced.markdown", "punctuation.definition.raw.markdown", "fenced_code.block.language", "variable.language.fenced.markdown"],
      "settings": { "foreground": "#7F92A3" }
    },
    {
      "name": "Markdown 引用",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7F92A3" }
    },
    {
      "name": "Markdown 链接描述",
      "scope": ["string.other.link.description", "string.other.link.title"],
      "settings": { "foreground": "#C4D7EA" }
    },
    {
      "name": "链接目标",
      "scope": ["markup.underline.link", "string.other.link", "constant.other.reference.link"],
      "settings": { "foreground": "#8FB5D9", "fontStyle": "underline" }
    },
    {
      "name": "Markdown 强调",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E19999", "fontStyle": "bold" }
    },
    {
      "name": "Markdown 斜体",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown 粗斜体",
