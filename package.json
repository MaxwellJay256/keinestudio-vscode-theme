{
  "name": "keinestudio-theme",
  "displayName": "KeineStudio Theme",
  "description": "KeineStudio color theme (Dark/Light) for Visual Studio Code",
  "publisher": "MaxwellJay256",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxwellJay256/keinestudio-vscode-theme.git"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build:themes": "node scripts/build-themes.mjs",
    "check:themes": "node scripts/build-themes.mjs --check",
    "test": "node --test scripts/build-themes.test.mjs",
    "vscode:prepublish": "npm run build:themes"
  },
  "contributes": {
    "themes": [
      {
        "label": "KeineStudio Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/keinestudio-dark-color-theme.json"
      },
      {
        "label": "KeineStudio Light",
        "uiTheme": "vs",
        "path": "./themes/keinestudio-light-color-theme.json"
      }
    ]
  }
}
